# Slack (never passed to pi)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# pi binary and working directory
PI_BIN=/home/pi-bot/.pi/agent/bin/pi
PI_WORKDIR=/opt/pi-workspace
# PI_PROVIDER=
# PI_MODEL=
# PI_THINKING=

# Who may use the agent, and what each role (none/viewer/member/admin) can do.
# Copy access.example.json, or generate one with: node list-users.js --init > access.json
# Re-read on every request, so edits apply without a restart.
ACCESS_FILE=/opt/pi-slack-bridge/access.json

# Default tools for the "member" role (and "admin" adds PI_TOOLS_TRUSTED).
# Roles in access.json can override these. bash/edit/write are never given by default.
PI_TOOLS=read,grep,find,ls,web_search_exa,deep_search_exa,web_fetch_exa
# PI_TOOLS_TRUSTED=read,grep,find,ls,web_search_exa,deep_search_exa,web_fetch_exa,bash,edit,write
# Legacy, only used when ACCESS_FILE is not set: these IDs become "admin", everyone else "member".
# TRUSTED_USER_IDS=U0123ABCD,U0456EFGH

# Extra env vars to hide from pi (SLACK_* are always hidden)
# PI_ENV_DENY=DATABASE_URL,AWS_SECRET_ACCESS_KEY

# JSON files whose key/token/secret fields get scrubbed from Slack replies
# Their file names are also hidden from replies.
PI_SECRET_FILES=/home/pi-bot/.pi/agent/auth.json,/home/pi-bot/.pi/agent/pi-exa.json,/home/pi-bot/.pi/agent/settings.json,/home/pi-bot/.config/deep-research/auth.json

# Extra paths to hide from replies (the bot's home and pi agent dir are always hidden)
# PI_REDACT_PATHS=/etc/pi-bot

# 'stdin' (pi reads piped input, per its CLI docs) keeps the prompt out of `ps` and
# avoids the 128 KB command-line limit, which big attachments can hit. 'argv' = old behaviour.
PI_PROMPT_VIA=stdin

# Memory per Slack thread (uses pi --session <file>); leave empty for --no-session
# PI_SESSION_DIR=/home/pi-bot/slack-sessions

# Limits
MAX_CONCURRENT_JOBS=2
MAX_JOBS_PER_USER=2
# Reports take longer than chat answers; raise this if PDFs time out
PI_TIMEOUT_MS=180000

# Context
HISTORY_LIMIT=50
CONTEXT_CHAR_BUDGET=24000
PER_MESSAGE_CHAR_LIMIT=3000
# false = in channels, always @mention the bot, also in its own threads (DMs never need it).
# true = after answering in a thread, the bot replies to every message there without a tag,
# until THREAD_FOLLOW_TTL_HOURS pass with no answer.
THREAD_FOLLOW=false
THREAD_FOLLOW_TTL_HOURS=72

# Help: "@bot help", "what can you do", "hi" or a bare mention shows a guide for the
# person's role; the app's Home tab shows it too. Examples use the bot's Slack username;
# set this if people know the bot by another name (e.g. its display name).
# BOT_DISPLAY_NAME=assistant
# Remembers which one-time tips each person has seen (first-use, deep research).
# HINTS_FILE=/home/pi-bot/.cache/slack-pi-bot/hints.json

# Output
# false = bot converts Markdown to Slack mrkdwn itself (recommended)
SLACK_MARKDOWN_BLOCKS=false
SLACK_REACTIONS=true
REPLY_FILE_THRESHOLD=12000

# Files the agent attaches (PDF needs: npm install md-to-pdf; Slack scope files:write)
MAX_FILES_PER_REPLY=3
MAX_FILE_BYTES=10000000
# Set true only if Chromium fails to start with a sandbox error (e.g. inside Docker)
PDF_NO_SANDBOX=false

# Deep research (pi package @juanhuttemann/pi-deep-research + the drsh CLI), admins only.
# In Slack: "@bot research <question>" -> plan card -> Start -> report as PDF + Markdown.
# Roles get it with "deepResearch": true in access.json (admin has it by default).
# Don't add deep_research / research_ask to PI_TOOLS: the bot adds them only where they belong.
# A run can take a long time; this is its own limit (default 60 minutes).
RESEARCH_TIMEOUT_MS=3600000
# How many research runs at once. Each holds one of MAX_CONCURRENT_JOBS, so keep it below that.
RESEARCH_MAX_CONCURRENT=1
# Reports, checkpoints and fetched pages, one folder per Slack thread. Hidden from replies.
# RESEARCH_DIR=/home/pi-bot/.cache/slack-pi-research
# Threads' research folders are deleted after this many days without use
# (after that, follow-up questions and Resume no longer work in that thread).
RESEARCH_KEEP_DAYS=30
# Only if drsh is not on the PATH of the bot's user:
# DRSH_BIN=/home/pi-bot/.local/bin/drsh

# Files people upload to Slack (needs scope files:read; PDF/DOCX/PPTX/XLSX need: npm install officeparser)
# Each request gets its own folder here, deleted when the request finishes.
# INPUT_FILES_DIR=/tmp/slack-pi-inputs
MAX_INPUT_FILES=5
MAX_INPUT_FILE_BYTES=20000000
# Uploaded images and images inside documents, sent to the (multimodal) model
MAX_INPUT_IMAGES=8
# How much extracted document text goes straight into the prompt; the rest stays readable via the read tool
ATTACHMENT_CHAR_BUDGET=40000
